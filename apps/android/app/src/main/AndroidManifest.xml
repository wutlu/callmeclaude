<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth device names in the audio route picker on API 29–30 (install-time there). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!--
        Android 17+ blocks LAN traffic for apps targeting SDK 37 unless this runtime permission
        (NEARBY_DEVICES group) is granted; the hub is usually reached by LAN IP. Older releases
        don't know the permission and keep allowing LAN access through INTERNET.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Declared by zxing-android-embedded as well; listed here so it is visible. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Hub connection kept in a foreground service (see HubService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Paired: reconnect after a reboot or an app update without the user opening the app (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        The system "stop optimising battery" dialog (Settings card). The hub can only reach the phone
        over the app's own socket, so Doze/app standby must not cut it; there is no FCM fallback.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Calls: self-managed ConnectionService, lock-screen ringing, call-time FGS types. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The pairing token must not leave the device: no cloud backup, no device-to-device transfer. -->
    <!-- Android 11+ package visibility: lets Speaker find the text-to-speech engine and its "install voice data" screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
    </queries>

    <application
        android:name=".CallMeClaudeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallMeClaude"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the icon: "Call Claude" (CallClaudeActivity). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            "Call Claude" from outside the app: app shortcut, quick settings tile, optional launcher
            entry. Invisible; decides and finishes. Own empty task so it never drags the main screen
            along, and shown over the lock screen so the tile can call without unlocking.
        -->
        <activity
            android:name=".CallClaudeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="dev.callmeclaude.action.CALL_CLAUDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Holds the WebSocket to the paired computer so it can ring this phone. There is no push
            service on Android: the hub announces calls over this socket. Idle it runs as specialUse,
            during a call as specialUse|phoneCall|microphone.
        -->
        <service
            android:name=".HubService"
            android:exported="false"
            android:foregroundServiceType="specialUse|phoneCall|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a WebSocket open to the user's own paired computer so it can ring this phone when a Claude Code session needs the user. No push service is used." />
        </service>

        <!-- "Call Claude" quick settings tile; tapping opens CallClaudeActivity. -->
        <service
            android:name=".CallClaudeTileService"
            android:exported="true"
            android:icon="@drawable/ic_call"
            android:label="@string/call_claude"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".calls.CmcConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <activity
            android:name=".calls.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity="dev.callmeclaude.call"
            android:turnScreenOn="true" />

        <receiver
            android:name=".calls.CallActionReceiver"
            android:exported="false" />

        <!-- Exported for the system broadcasts below, which only the system can send. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ZXing's scanner defaults to landscape; follow the device instead. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:ignore="DiscouragedApi"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
